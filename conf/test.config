// Smallest run that still exercises the real code path.
//
// Not a unit test: it runs the actual sceptre calls on the real object, just few enough of them to
// finish in minutes. 3 splits at 2 replicates is the same shape as the sbatch smoke test
// (workflow/slurm_executor/03_smoke_simulation.sbatch), which is what it is calibrated against.
//
//   nextflow run . -profile sherlock,test

params {
    outdir              = 'results/nextflow_test'
    effect_sizes        = [0.15]
    num_replicates      = 2

    // Splitting into 1,000 and simulating 3 of them keeps each task at a couple of minutes while
    // leaving the split geometry identical to a production run.
    n_splits            = 1000
    test_max_splits     = 3

    reps_per_null_chunk = 2
    test_max_null_reps  = 2
}
