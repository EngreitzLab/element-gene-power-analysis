+#' Return the fitted probabilities for a gRNA target, from a cache or by fitting
+#'
+#' The fit depends on only two things: which cells are perturbed (`trt_idxs`)
+#' and the covariate matrix. It does not depend on the response counts. So a
+#' caller that runs many analyses over the same cells and the same gRNA
+#' assignments -- varying only the response matrix, as a power simulation does
+#' -- refits an identical model on every call, and can instead fit once with
+#' `compute_grna_precomputations()` and pass the result in.
+#'
+#' The cache holds *coefficients*, not fitted values, for two reasons. It is
+#' what `@response_precomputations` stores, so the two caches are symmetric;
+#' and fitted values are one double per cell, which across a large screen and
+#' many targets would be gigabytes in the caller's session, against
+#' `ncol(covariate_matrix)` doubles per target here.
+#'
+#' Reconstruction is exact, not approximate. `stats::glm.fit()` computes the
+#' `fitted.values` it returns as `linkinv(drop(x %*% start))` from the same
+#' vector it returns as `coefficients`, and the offset is zero here, so
+#' `identical()` holds against the fit this replaces. What is traded away is
+#' the IRLS loop -- repeated QR decompositions of an n x p matrix -- for one
+#' matrix-vector product.
+#'
+#' @noRd
+resolve_grna_precomputation <- function(
+    grna_precomputations,
+    curr_grna_group,
+    trt_idxs,
+    covariate_matrix
+) {
+    cached <- if (curr_grna_group %in% names(grna_precomputations)) {
+        grna_precomputations[[curr_grna_group]]
+    } else {
+        NULL
+    }
+    if (is.null(cached)) {
+        return(perform_grna_precomputation(
+            trt_idxs = trt_idxs,
+            covariate_matrix = covariate_matrix,
+            return_fitted_values = TRUE
+        ))
+    }
+    check_grna_precomputation(cached, curr_grna_group, covariate_matrix)
+    return(stats::binomial()$linkinv(
+        drop(covariate_matrix %*% cached$fitted_coefs)
+    ))
+}
+
+
+#' Validate a user-supplied gRNA precomputation before reconstructing from it
+#'
+#' The caller supplied this, so a mismatch is a user error worth surfacing
+#' rather than something to paper over by silently refitting.
+#'
+#' Note which check does the work. The two CRT workhorse functions fit on
+#' *different cell sets* but the same covariates -- `crt_glm_factored_out()`
+#' uses every cell in use, `discovery_ntcells_crt()` uses the treatment cells
+#' followed by the NT cells -- so the coefficient vector has the same length in
+#' both and its length cannot distinguish them. `n_cells` can, which is why the
+#' cache records it. Without that check, a cache built for one path would be
+#' reconstructed against the other path's covariate matrix and produce
+#' plausible, wrong probabilities.
+#'
+#' @noRd
+check_grna_precomputation <- function(
+    cached,
+    curr_grna_group,
+    covariate_matrix
+) {
+    if (
+        !is.list(cached) ||
+            !all(c("fitted_coefs", "n_cells") %in% names(cached))
+    ) {
+        stop(
+            "The gRNA precomputation supplied for `",
+            curr_grna_group,
+            "` is not a list with `fitted_coefs` and `n_cells` elements. ",
+            "Build it with `compute_grna_precomputations()`."
+        )
+    }
+    coefs <- cached$fitted_coefs
+    if (!is.numeric(coefs) || anyNA(coefs)) {
+        stop(
+            "The gRNA precomputation supplied for `",
+            curr_grna_group,
+            "` has missing or non-numeric coefficients."
+        )
+    }
+    if (length(coefs) != ncol(covariate_matrix)) {
+        stop(
+            "The gRNA precomputation supplied for `",
+            curr_grna_group,
+            "` has ",
+            length(coefs),
+            " coefficients, but the covariate matrix has ",
+            ncol(covariate_matrix),
+            " columns. It was computed under a different model formula; ",
+            "rebuild it with `compute_grna_precomputations()`."
+        )
+    }
+    if (
+        !identical(
+            as.integer(cached$n_cells),
+            as.integer(nrow(covariate_matrix))
+        )
+    ) {
+        stop(
+            "The gRNA precomputation supplied for `",
+            curr_grna_group,
+            "` was fitted on ",
+            cached$n_cells,
+            " cells, but ",
+            nrow(covariate_matrix),
+            " cells are being analyzed for this gRNA target. Rebuild it with ",
+            "`compute_grna_precomputations()` on the same `sceptre_object`, ",
+            "for the same analysis."
+        )
+    }
+    invisible(TRUE)
+}
+
