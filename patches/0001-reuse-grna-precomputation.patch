+#' Compute the gRNA precomputations for a discovery analysis or power check
+#'
+#' `compute_grna_precomputations()` fits, for each gRNA target, the logistic
+#' regression of perturbation indicator onto the covariate matrix whose fitted
+#' values are the per-cell probabilities from which the conditional
+#' randomization test draws synthetic treatment assignments. Pass the result to
+#' `run_discovery_analysis()` or `run_power_check()` via their
+#' `grna_precomputations` argument to skip refitting it.
+#'
+#' This is a memoization, not an approximation: the fit depends only on the
+#' gRNA-to-cell assignments and the covariate matrix, neither of which depends
+#' on the response counts, so the reused fit is identical to the one that would
+#' have been computed. It is worth doing when the same `sceptre_object` is
+#' analyzed repeatedly with only `@response_matrix` changing -- for example
+#' when estimating power by simulating counts many times over a fixed design.
+#'
+#' The synthetic treatment assignments themselves are *not* cached; they are
+#' redrawn inside every call, so the resampling distribution is unaffected.
+#'
+#' @details
+#' The result is valid only for the object it was computed from, and it carries
+#' no reset hook, so recompute it after anything that changes the model or the
+#' cells it is fitted over: a new `formula_object` from
+#' `set_analysis_parameters()`, a re-run of `assign_grnas()`, or different QC.
+#' A changed formula is caught on use (the coefficient count no longer
+#' matches), and so is a cache built for the wrong control group (the cell
+#' count no longer matches), but a cache that is stale in some way that leaves
+#' both dimensions intact is not detectable and will be used.
+#'
+#' A discovery analysis and a power check on the same object share both the
+#' target key space and the cell space, so one cache serves both. The
+#' calibration check is deliberately not supported: its gRNA group keys are
+#' synthetic undercover-NT group names regenerated on every call, so a cache
+#' would never hit.
+#'
+#' Targets whose covariates are rank deficient *within their own cells* are
+#' omitted with a warning rather than cached, and are fitted as usual. This is
+#' only reachable when the control group is the NT cells, since
+#' `set_analysis_parameters()` already rejects a globally rank-deficient
+#' design.
+#'
+#' @param sceptre_object a `sceptre_object` on which `assign_grnas()` and
+#' `run_qc()` have been called
+#' @param analysis a string naming the analysis the cache is for, either
+#' `"discovery_analysis"` or `"power_check"`. It selects which pairs the
+#' default set of targets is taken from.
+#' @param grna_targets (optional) character vector of gRNA targets to fit;
+#' defaults to every target appearing in the pairs for `analysis`
+#'
+#' @return a named list with one entry per gRNA target, each a list of
+#' `fitted_coefs` (the logistic regression coefficients) and `n_cells` (the
+#' number of cells they were fitted over)
+#' @export
+compute_grna_precomputations <- function(
+    sceptre_object,
+    analysis = "discovery_analysis",
+    grna_targets = NULL
+) {
+    if (!(analysis %in% c("discovery_analysis", "power_check"))) {
+        stop(
+            "`analysis` must be either `discovery_analysis` or ",
+            "`power_check`. The calibration check is not supported: it ",
+            "generates a fresh set of gRNA group names on every call, so a ",
+            "cache cannot hit."
+        )
+    }
+    cells_in_use <- sceptre_object@cells_in_use
+    if (length(cells_in_use) == 0L) {
+        stop(
+            "`cells_in_use` is empty. Call `run_qc()` before ",
+            "`compute_grna_precomputations()`."
+        )
+    }
+    grna_group_idxs <- sceptre_object@grna_assignments$grna_group_idxs
+    if (length(grna_group_idxs) == 0L) {
+        stop(
+            "`grna_assignments$grna_group_idxs` is empty. Call ",
+            "`assign_grnas()` and `run_qc()` before ",
+            "`compute_grna_precomputations()`."
+        )
+    }
+    if (is.null(grna_targets)) {
+        pairs <- if (identical(analysis, "discovery_analysis")) {
+            sceptre_object@discovery_pairs_with_info
+        } else {
+            sceptre_object@positive_control_pairs_with_info
+        }
+        grna_targets <- pairs$grna_group
+    }
+    grna_targets <- unique(as.character(grna_targets))
+    absent <- setdiff(grna_targets, names(grna_group_idxs))
+    if (length(absent) > 0L) {
+        stop(
+            length(absent),
+            " gRNA target(s) have no entry in ",
+            "`grna_assignments$grna_group_idxs`, including: ",
+            paste0(utils::head(absent, 5L), collapse = ", "),
+            "."
+        )
+    }
+
+    # Reproduce run_crt_in_memory_v2()'s row space by calling the same factory
+    # it does, rather than reimplementing the indexing. `calibration_check` is
+    # FALSE because neither supported analysis is one, which also makes
+    # `subset_to_nt_cells` FALSE, so the covariate matrix is subset to the
+    # cells in use and no further.
+    get_idx_f <- get_idx_vector_factory(
+        calibration_check = FALSE,
+        indiv_nt_grna_idxs = sceptre_object@grna_assignments$indiv_nt_grna_idxs,
+        grna_group_idxs = grna_group_idxs,
+        low_moi = sceptre_object@low_moi
+    )
+    covariate_matrix <- sceptre_object@covariate_matrix[
+        cells_in_use,
+        ,
+        drop = FALSE
+    ]
+    all_nt_idxs <- sceptre_object@grna_assignments$all_nt_idxs
+    run_outer_regression <- sceptre_object@control_group_complement
+
+    out <- list()
+    rank_deficient <- character(0)
+    for (curr_grna_group in grna_targets) {
+        idxs <- get_idx_f(curr_grna_group)
+        if (run_outer_regression) {
+            # crt_glm_factored_out(): every cell in use, treatment indicated
+            # by trt_idxs.
+            curr_covariate_matrix <- covariate_matrix
+            trt_idxs <- idxs$trt_idxs
+        } else {
+            # discovery_ntcells_crt(): the treatment cells followed by the NT
+            # cells.
+            curr_covariate_matrix <- covariate_matrix[
+                c(idxs$trt_idxs, all_nt_idxs),
+            ]
+            trt_idxs <- seq(1L, idxs$n_trt)
+        }
+        fitted_coefs <- perform_grna_precomputation(
+            trt_idxs = trt_idxs,
+            covariate_matrix = curr_covariate_matrix,
+            return_fitted_values = FALSE
+        )
+        # A covariate that is constant within this group's cells is aliased,
+        # and glm.fit returns NA for its coefficient while still returning
+        # valid fitted values. Reconstructing from an NA coefficient would
+        # make every probability NA, so such a group is left out of the cache
+        # instead of poisoning it.
+        if (anyNA(fitted_coefs)) {
+            rank_deficient <- c(rank_deficient, curr_grna_group)
+            next
+        }
+        out[[curr_grna_group]] <- list(
+            fitted_coefs = fitted_coefs,
+            n_cells = nrow(curr_covariate_matrix)
+        )
+    }
+    if (length(rank_deficient) > 0L) {
+        warning(
+            length(rank_deficient),
+            " gRNA target(s) have rank-deficient covariates within their own ",
+            "cells, so they were omitted from the cache and will be fitted ",
+            "as usual: ",
+            paste0(utils::head(rank_deficient, 5L), collapse = ", "),
+            ".",
+            call. = FALSE
+        )
+    }
+    return(out)
+}
